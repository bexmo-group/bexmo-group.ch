---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  quote: string;
  name: string;
  role: string;
  avatar: ImageMetadata;
}
const { quote, name, role, avatar } = Astro.props;
---
<div style="background:#000;color:#fff;border:1px solid var(--blue-700);border-radius:16px;padding:32px;max-width:350px;box-shadow:var(--shadow-black-glow)">
  <blockquote class="m-body" style="margin:0 0 24px;font-size:18px;line-height:1.625"><p style="margin:0">{quote}</p></blockquote>
  <div style="display:flex;align-items:center;gap:12px">
    <Image src={avatar} alt="" width={80} height={80} style="width:40px;height:40px;border-radius:9999px;object-fit:cover" />
    <div>
      <p style="margin:0;font-weight:600;font-size:14px">{name}</p>
      <p style="margin:0;font-size:12px;color:var(--gray-400)">{role}</p>
    </div>
  </div>
</div>
