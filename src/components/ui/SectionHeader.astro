---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  continuation?: string;
}
const { id, index, eyebrow, title, continuation } = Astro.props;
---
<section id={id} class="m-head" style="padding:0 40px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);scroll-margin-top:80px">
  <div style="max-width:1330px;margin:0 auto">
    <div style="padding:48px 48px 48px;border-left:1px solid var(--border);border-right:1px solid var(--border)">
      <p style="margin:0 0 80px;padding-bottom:16px;font-size:12px;font-weight:500;text-transform:uppercase;letter-spacing:.025em;opacity:.5;color:var(--neutral-900);font-feature-settings:'tnum' 1,'zero' 1"><span style="opacity:.7;padding-right:8px">[{index}]</span>{eyebrow}</p>
      <h2 style="margin:0;padding-right:64px;font-family:var(--font-serif);font-weight:400;font-size:38px;line-height:52px;letter-spacing:-.6px;text-wrap:pretty">{title}{continuation && <Fragment>&nbsp;<br /><span style="color:var(--neutral-400)">{continuation}</span></Fragment>}</h2>
    </div>
  </div>
</section>
