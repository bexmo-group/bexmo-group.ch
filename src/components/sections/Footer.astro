---
const year = new Date().getFullYear();
---
<footer class="wist-shader" data-ref-height="860" data-seed="0" data-stretch="6" style="position:relative;isolation:isolate;overflow:hidden;width:100%;height:50px;background:#000">
  <div class="m-foot" style="position:absolute;inset:0;z-index:2;padding:0 40px;pointer-events:none">
    <div style="max-width:1330px;height:100%;margin:0 auto;display:flex;align-items:center;padding:0 32px;gap:16px">
      <span style="color:#fff;font-size:13px;opacity:.8;margin-left:auto">© {year} Bexmo Group</span>
    </div>
  </div>
</footer>
