---
import { getT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const t = getT(Astro.props.locale).manifesto;
// ASCII wordmark; "~" stands for a backslash (avoids escaping issues in the template).
const ascii = [
  " ____  _____ __  __ __  __  ___",
  "| __ )| ____|~ ~/ /|  ~/  |/ _ ~",
  "|  _ ~|  _|   ~  / | |~/| | | | |",
  "| |_) | |___  /  ~ | |  | | |_| |",
  "|____/|_____|/_/~_~|_|  |_|~___/ ",
].join(String.fromCharCode(10)).replaceAll('~', String.fromCharCode(92));
---
<section style="padding:0 40px;background:#000">
  <div class="wist-dark-grid m-manifesto" style="max-width:1330px;margin:0 auto;padding:144px 16px 136px;border-right:1px solid var(--blue-700)">
    <div class="m-manifesto-card" style="max-width:730px;margin:0 auto;background:#000;color:#fff;border:1px solid var(--blue-700);border-radius:24px;padding:80px 80px 120px;box-shadow:var(--shadow-black-glow);font-family:var(--font-courier)">
      <div class="m-body" style="max-width:440px;margin:0 auto;display:flex;flex-direction:column;gap:20px;color:var(--neutral-200);font-size:18px;line-height:1.625">
        <p class="m-manifesto-title" style="font-family:var(--font-lido-cond);font-size:44px;line-height:48px;letter-spacing:-.5px;color:#fff;margin:20px 0 40px">{t.title[0]}<br />{t.title[1]}</p>
        {t.paragraphs.map((lines) => (
          <p style="margin:0">{lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
        ))}
        <p style="margin:20px 0 0">{t.outro}</p>
        <pre aria-label="BEXMO" style="font-family:monospace;font-size:10px;line-height:16px;margin:-16px 0 0">{ascii}</pre>
      </div>
    </div>
  </div>
</section>
