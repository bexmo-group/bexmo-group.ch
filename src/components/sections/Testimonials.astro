---
import Testimonial from '../ui/Testimonial.astro';
import { getT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const t = getT(Astro.props.locale).testimonials;
const layout = [
  { y: 0, rot: 0.2 },
  { y: 96, rot: -0.3 },
  { y: 24, rot: 0.3 },
  { y: 128, rot: -0.2 },
];
---
<section style="padding:0 40px;background:#000">
  <div class="wist-dark-grid" style="max-width:1330px;margin:0 auto;padding:40px 0;border-right:1px solid var(--blue-700)">
    <div class="m-testi testi-grid">
      {t.map(([quote, name, role], i) => {
        const p = layout[i];
        return (
          <div style={`margin-top:${p.y}px;transform:rotate(${p.rot}deg)`}>
            <Testimonial quote={quote} name={name} role={role} />
          </div>
        );
      })}
    </div>
  </div>
</section>
